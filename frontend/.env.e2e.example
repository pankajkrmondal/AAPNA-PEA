# Copy to .env.e2e and fill in. That file is gitignored; this one is not, so
# never put a real password here.
#
# The suite proves the role gating on Settings, so it wants three accounts.
# Any role whose password is blank is SKIPPED rather than failed, so the tests
# still run with only the super admin filled in — you just lose the negative
# half of the role checks.

E2E_BASE_URL=http://localhost:5173

# Super admin — sees the pea_settings column names and the "Not in effect" tab.
E2E_SUPERADMIN_USER=qa.superadmin
E2E_SUPERADMIN_PASS=

# Admin — same settings, no keys, no "Not in effect" tab.
E2E_ADMIN_USER=qa.admin
E2E_ADMIN_PASS=

# HR — as admin, and read-only on settings.
E2E_HR_USER=qa.hr
E2E_HR_PASS=
