{
  "name": "pea-backend",
  "version": "1.0.0",
  "description": "PEA (Performance Evaluation Automation) Backend — migrated from Power Automate flows",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:staging": "cross-env NODE_ENV=staging node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:staging": "cross-env NODE_ENV=staging nodemon src/server.js",

    "//  PRISMA  ": "=== Only `generate` exists here, and that is deliberate. ===",
    "//  WARNING ": "PEA has its own databases (peaStagingDB / peaProductionDB, login peauser) since 15 Sep 2026. schema.prisma is HAND-WRITTEN and the schema is SQL-first: never run `prisma migrate dev`, `db push` or `db pull`. Schema changes go through a reviewed file in prisma/ddl/; the full schema is prisma/ddl/pea-dedicated-database.sql.",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",

    "seed:admin": "node prisma/seed-admin.js",
    "test": "node --test \"src/tests/**/*.test.js\"",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "performance-evaluation",
    "hr",
    "express",
    "prisma"
  ],
  "license": "UNLICENSED",
  "private": true
}
