# ═══════════════════════════════════════════════════════════════════════════
#  PEA — environment template
#
#  This file IS committed. It carries the shape, never the values.
#  Copy to .env.development / .env.staging / .env.production and fill in.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# 5002 = PEA staging/dev, 5003 = PEA production.
# (5000 and 5001 are taken by ATS staging and ATS production.)
PORT=5002


# ── Database ────────────────────────────────────────────────────────────────
#  Two things that are easy to get wrong:
#
#  1. Percent-encode the password. `#` -> %23, `@` -> %40, `/` -> %2F.
#     An unencoded `#` silently truncates the URL.
#
#  2. PEA's pea_ tables share the `public` schema with the ATS rpa_ tables.
#     NEVER run prisma migrate / db push / db pull here — see the ddl README.
#     prisma/schema.prisma is hand-written with pea_ models only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=10"


# ── Auth ────────────────────────────────────────────────────────────────────
#  Must differ from the ATS secret — an ATS token must not be valid in PEA.
JWT_SECRET=
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d


# ── Microsoft Graph (email) ─────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

#  Shared mailbox. Empty falls back to MS_DEFAULT_SENDER_EMAIL.
PEA_SENDER_EMAIL=
MS_DEFAULT_SENDER_EMAIL=
PEA_REPLY_TO=


# ── Email safety ────────────────────────────────────────────────────────────
#  true everywhere except production. Rewrites every recipient to the test
#  inbox and clears CC.
EMAIL_REDIRECT_TO_TEST=true
EMAIL_STAGING_RECIPIENTS=
EMAIL_UAT_ALLOWLIST=


# ── Scheduler ───────────────────────────────────────────────────────────────
TZ=Asia/Kolkata
PEA_SCHEDULER_ENABLED=false


# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=


# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
