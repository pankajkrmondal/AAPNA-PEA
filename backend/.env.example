# ═══════════════════════════════════════════════════════════════════════════
#  PEA — environment template
#
#  This file IS committed. It carries the shape, never the values.
#  Copy to .env.development / .env.staging / .env.production and fill in.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# 5002 = PEA staging/dev, 5003 = PEA production.
# (5000 and 5001 are taken by ATS staging and ATS production.)
PORT=5002


# ── Database ────────────────────────────────────────────────────────────────
#  Two things that are easy to get wrong:
#
#  1. Percent-encode the password (JavaScript encodeURIComponent):
#     `@` -> %40, `#` -> %23, `/` -> %2F, `[` -> %5B, `^` -> %5E, `(` -> %28.
#     An unencoded `#` silently truncates the URL.
#
#  2. PEA has its OWN databases, separate from ATS, with the login peauser:
#     peaStagingDB (staging / development) and peaProductionDB (production).
#     Schema: prisma/ddl/pea-dedicated-database.sql. PEA reads no ATS data.
#     prisma/schema.prisma is hand-written; never run prisma migrate / db push / db pull.
DATABASE_URL="postgresql://peauser:PERCENT_ENCODED_PASSWORD@20.244.34.176:5432/peaStagingDB?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=10"


# ── Auth ────────────────────────────────────────────────────────────────────
#  Must differ from the ATS secret — an ATS token must not be valid in PEA.
JWT_SECRET=
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d


# ── Cloudflare Turnstile (login page) ───────────────────────────────────────
#  Secret key of the Turnstile widget. Its site key goes in the frontend's
#  VITE_TURNSTILE_SITE_KEY. Staging and production refuse to start without it.
#  Local development: Cloudflare's always-pass test secret
#  1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=


# ── Microsoft Graph (email) ─────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

#  Shared mailbox. Empty falls back to MS_DEFAULT_SENDER_EMAIL.
PEA_SENDER_EMAIL=
MS_DEFAULT_SENDER_EMAIL=
PEA_REPLY_TO=


# ── Email safety ────────────────────────────────────────────────────────────
#  Outside production every recipient is rewritten to the addresses below and
#  CC is cleared, ALWAYS. Setting EMAIL_REDIRECT_TO_TEST=false outside
#  production makes the app refuse to start.
#  FAIL CLOSED: empty list outside production = the app refuses to start.
EMAIL_REDIRECT_TO_TEST=true
EMAIL_STAGING_RECIPIENTS=


# ── Scheduler ───────────────────────────────────────────────────────────────
TZ=Asia/Kolkata
PEA_SCHEDULER_ENABLED=false


# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=


# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
